
# Application Environment
APP_ENV=development
DEBUG=true


# PostgreSQL Configuration (OPTIONAL — used only to log prediction rows).
# If any POSTGRES_* var is unset, the database is disabled and the service still
# boots and serves /predict + /feedback; predictions just aren't persisted.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password

# Verbose SQL query logging (off by default). Set true only when debugging DB.
DB_ECHO=false


# Database URL (Async SQLAlchemy — used by backend/db/database.py)
DATABASE_URL=postgresql+asyncpg://your_database_user:your_database_password@postgres:5432/your_database_name


# pgAdmin Configuration (Optional)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin_password


# Backend / API Settings
API_HOST=0.0.0.0
API_PORT=8000

# --- FastAPI app / inference (backend/app/config.py via pydantic-settings) ---

# Model artifact (directory containing model_inference.pt + config.json, or path
# to a .pt file). The Docker image bakes the model at /app/exports/v3.0 and sets
# this automatically; set it explicitly only for a non-Docker / local run.
MODEL_PATH=

# local | s3 (S3 loading is stubbed unless you extend ModelService)
MODEL_SOURCE=local

# cpu | cuda
DEVICE=cpu

# Max upload size for POST /api/v1/predict (MB)
MAX_AUDIO_SIZE_MB=10

# CORS: comma-separated or JSON list, e.g. http://localhost:3000,http://127.0.0.1:3000
# In production (PRODUCTION_MODE=true), "*" is rejected at startup.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# true = production safeguards (strict model path, no CORS "*", hide error details)
PRODUCTION_MODE=false

# API/service version exposed in OpenAPI and GET /health
SERVICE_VERSION=0.1.0

# Logging: DEBUG | INFO | WARNING | ERROR | CRITICAL (JSON logs via structlog)
LOG_LEVEL=INFO

# Directory for HITL therapist corrections (audio WAVs + feedback.jsonl manifest)
# collected via POST /api/v1/feedback. Used when STORAGE_BACKEND=local.
FEEDBACK_DIR=feedback_data

# Max decoded WAV size accepted by POST /api/v1/feedback (MB)
MAX_FEEDBACK_AUDIO_MB=5

# Audio cleanup before inference (high-pass + silence-trim + normalize).
# ON by default — validated to not hurt accuracy (52.4%->54.4%) + adds noise
# robustness. The quality gate (warnings) runs regardless. Set false for raw.
PREPROCESS_ENABLED=true

# --- S3 storage (audio + HITL corpus) ---
# local = feedback stays in FEEDBACK_DIR; s3 = audio + corpus live in S3.
# With s3, /predict also accepts an `s3_key` form field (AI downloads the clip)
# and /feedback stores each correction as <prefix><id>.wav + <id>.json.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
# Optional: override endpoint for an S3-compatible store or a local mock.
S3_ENDPOINT_URL=
S3_PREDICT_PREFIX=predict-audio/
S3_FEEDBACK_PREFIX=feedback/
# AWS credentials come from the standard chain (env / IAM role / ~/.aws):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
