# Production environment for the AI service.
APP_ENV=production
DEBUG=false

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stuttering_ai
POSTGRES_USER=stuttering_ai
POSTGRES_PASSWORD=change-me

# Database URL (Async SQLAlchemy, used by backend/db/database.py)
DATABASE_URL=postgresql+asyncpg://stuttering_ai:change-me@postgres:5432/stuttering_ai

# Backend / API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Model artifact directory containing model_inference.pt and config.json.
MODEL_SOURCE=local
MODEL_PATH=/app/models
MODEL_VERSION=
MODEL_CACHE_DIR=/app/model_cache

# Inference runtime
DEVICE=cpu
MAX_AUDIO_SIZE_MB=10
MULTI_LABEL_THRESHOLD=0.5

# Production safeguards
PRODUCTION_MODE=true
ALLOWED_ORIGINS=

# Sync-style DB URL for app settings.
DB_URL=postgresql://stuttering_ai:change-me@postgres:5432/stuttering_ai

# API/service version exposed in OpenAPI and GET /health
SERVICE_VERSION=0.1.0

# Production logging should emit WARNING and above.
LOG_LEVEL=WARNING
