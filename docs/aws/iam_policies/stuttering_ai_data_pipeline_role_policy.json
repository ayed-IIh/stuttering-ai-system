{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListBucket",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::stuttering-ai-data",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "",
                        "raw/",
                        "raw/*"
                    ]
                }
            }
        },
        {
            "Sid": "AccessRawObjects",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": "arn:aws:s3:::stuttering-ai-data/raw/*"
        }
    ]
}