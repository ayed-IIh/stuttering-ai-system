{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowLogsReadRole",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::540034107912:role/stuttering-ai-model-read-role"
            },
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::stuttering-ai-logs",
                "arn:aws:s3:::stuttering-ai-logs/*"
            ]
        }
    ]
}